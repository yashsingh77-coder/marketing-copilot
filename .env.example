# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by cron jobs + admin tasks.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (content generation) -----------------------------------------------
# Default provider is Anthropic via the Vercel AI SDK. Swap in lib/ai/client.ts.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5

# --- Speech-to-text (Voice/Video-to-Post) ----------------------------------
DEEPGRAM_API_KEY=

# --- Meta (Instagram + Facebook) -------------------------------------------
META_APP_ID=
META_APP_SECRET=
# 32-byte hex key for encrypting long-lived access tokens at rest
META_TOKEN_ENCRYPTION_KEY=
NEXT_PUBLIC_META_REDIRECT_URI=http://localhost:3000/api/meta/callback

# --- Competitor discovery --------------------------------------------------
GOOGLE_PLACES_API_KEY=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Protects /api/cron/* routes. Vercel sends this automatically as a Bearer token.
CRON_SECRET=
